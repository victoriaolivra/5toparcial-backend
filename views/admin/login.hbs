<section class="tarjeta tarjeta-login">
  <h1>Ingresar</h1>

  {{#if error}}
  <p class="aviso aviso-error" role="alert">{{error}}</p>
  {{/if}}

  <form method="post" action="/admin/login">
    <label for="usuario">Usuario</label>
    <input type="text" id="usuario" name="usuario" value="{{usuario}}" maxlength="50" autocomplete="username" required autofocus>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" maxlength="72" autocomplete="current-password" required>

    <button type="submit" class="boton">Entrar</button>
  </form>
</section>