<section class="tarjeta">
  <h1>Eliminar contacto</h1>
  <p>¿Seguro que querés eliminar este mensaje? <strong>No se puede deshacer.</strong></p>

  <div class="contacto contacto-confirmar">
    <div class="contacto-cabecera">
      <strong>{{contacto.nombre}}</strong>
      <span class="contacto-fecha">{{contacto.fecha}}</span>
    </div>
    <p class="contacto-telefono">Teléfono: {{contacto.telefono}}</p>
    <p class="contacto-mensaje">{{contacto.mensaje}}</p>
  </div>

  <form method="post" action="/admin/contactos/{{contacto.id}}/eliminar" class="acciones">
    <input type="hidden" name="filtro" value="{{contacto.filtro}}">
    <button type="submit" class="boton boton-peligro">Sí, eliminar</button>
    <a href="/admin/contactos{{#if contacto.filtro}}?filtro={{contacto.filtro}}{{/if}}" class="enlace-cancelar">Cancelar</a>
  </form>
</section>